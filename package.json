{
  "name": "@russell-marketing/brand-ui",
  "version": "1.9.4",
  "description": "Russell Marketing brand UI - design tokens, components, and accessibility utilities",
  "type": "module",
  "main": "ui/rm-ui.entry.js",
  "style": "ui/rm-ui.entry.css",
  "bin": {
    "rm-brand-audit": "scripts/audit.mjs",
    "rm-brand-copy": "scripts/copy.mjs"
  },
  "exports": {
    ".": {
      "import": "./ui/rm-ui.entry.js",
      "default": "./ui/rm-ui.entry.js"
    },
    "./styles": "./ui/rm-ui.entry.css",
    "./layout": "./ui/layout.entry.css",
    "./tokens": "./ui/tokens.css",
    "./tokens.js": {
      "types": "./ui/tokens.d.ts",
      "import": "./ui/tokens.js",
      "default": "./ui/tokens.js"
    },
    "./core": "./ui/core.css",
    "./dark": "./ui/dark.css",
    "./utilities": "./ui/utilities.css",
    "./a11y": "./ui/a11y.css",
    "./components/*": "./ui/components/*.css",
    "./adapters/mui-theme": {
      "types": "./adapters/mui-theme.d.ts",
      "import": "./adapters/mui-theme.js",
      "default": "./adapters/mui-theme.js"
    },
    "./react/SliderWithLabel": "./components/react/SliderWithLabel.jsx",
    "./react/RateField": "./components/react/RateField.jsx",
    "./react/Rating": {
      "types": "./components/react/Rating.d.ts",
      "default": "./components/react/Rating.jsx"
    }
  },
  "files": [
    "ui/**/*",
    "scripts/**/*",
    "tokens/**/*",
    "adapters/**/*",
    "components/**/*",
    "README.md",
    "LICENSE",
    "RULES.md",
    "docs/migrating-*.md"
  ],
  "peerDependencies": {
    "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    }
  },
  "keywords": [
    "design-system",
    "css",
    "design-tokens",
    "accessibility",
    "russell-marketing"
  ],
  "author": "Russell Marketing",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/russell-marketing/rm-brand-ui.git"
  },
  "scripts": {
    "dev": "npx http-server -p 3000 -o demo.html",
    "build:tokens": "node scripts/build-tokens.mjs",
    "test": "node scripts/build-tokens.mjs --check && node scripts/verify-tokens.mjs && node scripts/test-components.mjs && node scripts/test-tools.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "types": "ui/tokens.d.ts"
}
